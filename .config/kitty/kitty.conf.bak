#SHELL
shell /usr/bin/zsh

#MODIFY KEY
kitty_mod ctrl+shift

# BEGIN_KITTY_THEME
# GitHub Dark High Contrast
include current-theme.conf
# END_KITTY_THEME

#FONT
# font_family      JetBrainsMono Nerd Font
# bold_font        auto
# italic_font      auto
# bold_italic_font auto
font_size 14

#LAYOUT - THE TALL LAYOUT
enabled_layouts tall,*

#WINDOWS 
window_margin_width 7
window_border_width 2pt

#BACKGROUND
#background_image ~/Pictures/dune.jpeg
background_image_layout cscaled
background_tint 0.8
background_tint_gaps -10
#background_opacity 0.9

#TABS
tab_bar_style powerline
tab_powerline_style slanted
tab_activity_symbol *

#MAPPING
map F1 new_window_with_cwd
map F4 new_tab_with_cwd
map F2 send_text all nvim .\r
map F3 launch --cwd=current --type=tab nvim .
map alt+w close_window
map alt+q close_tab

#GIAM DELAY
sync_to_monitor no
repaint_delay 10
input_delay 3
resize_debounce_time 0
resize_draw_strategy static

term xterm-256color

# BEGIN_KITTY_FONTS
font_family      family="Cascadia Code"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
